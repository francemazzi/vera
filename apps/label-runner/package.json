{
  "name": "@vera/label-runner",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run --dir test/unit",
    "test:integration": "vitest run --dir test/integration",
    "test:smoke:openrouter": "vitest run test/smoke/openrouter-live.test.ts",
    "benchmark:openrouter": "node dist/model-benchmark.js",
    "dataset:cipriani-pasta": "node dist/build-cipriani-pasta-dataset.js",
    "replay:cipriani-pasta": "node dist/cipriani-pasta-replay.js",
    "probe:us-pasta-sources": "node dist/probe-us-pasta-sources.js",
    "archive:preliminary-sources": "node dist/import-preliminary-sources.js"
  },
  "dependencies": {
    "@google-cloud/storage": "7.19.0",
    "@vera/contracts": "workspace:*",
    "@vera/rag": "workspace:*",
    "fastify": "catalog:",
    "google-auth-library": "9.15.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
