{
  "name": "vera",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.22.1 <23",
    "pnpm": ">=10.33.0 <11"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "clean": "pnpm -r --if-present clean && pnpm docs:clean",
    "docs:build": "vitepress build docs",
    "docs:clean": "rm -rf docs/.vitepress/.temp docs/.vitepress/cache docs/.vitepress/dist",
    "docs:dev": "vitepress docs",
    "docs:preview": "vitepress preview docs",
    "generate": "pnpm -r --if-present generate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm generate && eslint . --max-warnings 0",
    "npm:verify": "node scripts/verify-npm-packages.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "pnpm -r --if-present test:unit",
    "test:integration": "pnpm -r --if-present test:integration",
    "test:contract": "pnpm -r --if-present test:contract",
    "test:e2e": "pnpm -r --if-present test:e2e",
    "test:smoke:openrouter": "pnpm --filter @vera/extractors test:smoke:openrouter && pnpm --filter @vera/rag test:smoke:openrouter && pnpm --filter @vera/label-runner test:smoke:openrouter",
    "test:coverage": "vitest run --coverage",
    "datasets:audit": "pnpm --filter @vera/dataset-harness build && node packages/dataset-harness/dist/cli.js --projection .vera-private/dataset-audit.json",
    "verify:local-datasets": "pnpm verify && pnpm datasets:audit",
    "public-boundary:check": "pnpm --filter @vera/public-boundary scan",
    "security:check": "docker run --rm -v \"$PWD:/src:ro\" ghcr.io/google/osv-scanner:v2.4.0 scan source -L /src/pnpm-lock.yaml",
    "verify": "pnpm generate && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:contract && pnpm build && pnpm npm:verify && pnpm docs:build && pnpm test:e2e && pnpm test:coverage && pnpm public-boundary:check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.8.1",
    "prettier": "3.9.6",
    "prisma": "7.9.1",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vitepress": "1.6.4",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server": "2.0.10",
      "fast-uri@^3": "3.1.4",
      "fast-uri@^4": "4.1.1",
      "uuid": "11.1.1",
      "vitepress>vite": "6.4.3"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "@docsearch/react>@types/react": "19",
        "@docsearch/react>react": "19",
        "@docsearch/react>react-dom": "19"
      }
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
