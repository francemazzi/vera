# Local runtime
NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL and pgvector
POSTGRES_DB=vera
POSTGRES_USER=vera
POSTGRES_PASSWORD=local-only
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql://vera:local-only@127.0.0.1:5432/vera?schema=public
# Optional migration-only override. Set this to `vera` when VERA shares the
# SILTO database: Prisma Migrate will then use the isolated `vera` schema and
# its own `_prisma_migrations` ledger. The runtime governance service uses
# GOVERNANCE_DATABASE_SCHEMA below.
VERA_DATABASE_SCHEMA=

# Future API and web applications
API_HOST=127.0.0.1
API_PORT=3000
WEB_HOST=127.0.0.1
WEB_PORT=5173
VITE_API_BASE_URL=http://127.0.0.1:3000/v1

# OpenRouter is opt-in for existing technical demos. Never expose this key via VITE_*.
OPENROUTER_API_KEY=
VERA_OPENROUTER_LIVE=0
VERA_LABEL_RUNNER_OPENROUTER_LIVE=0

# Optional local Ollama RAG smoke (@vera/rag). When unset, smoke records a hashed limitation.
VERA_OLLAMA_RAG_MODEL=
VERA_OLLAMA_RAG_DIGEST=
VERA_OLLAMA_RUNTIME_VERSION=

# Private SILTO-LABEL runner. In Cloud Run, OPENROUTER_API_KEY is injected from Secret Manager.
# It never falls back to Ollama or any local model.
LABEL_RUNNER_MODE=evaluation
LABEL_BACKEND_URL=
LABEL_BACKEND_AUDIENCE=
LABEL_RUNNER_AUDIENCE=
LABEL_TASKS_INVOKER_SERVICE_ACCOUNT_EMAIL=
LABEL_GCS_BUCKET=
LABEL_OPENROUTER_MODEL=
LABEL_PROMPT_VERSION=label-evaluation-v1
LABEL_RULE_PACK_VERSION=
LABEL_SOURCE_SNAPSHOT=
LABEL_OPENROUTER_TIMEOUT_MS=60000

# Private SILTO-LABEL source governance worker. In Cloud Run, secrets are injected
# from Secret Manager; do not put a real OpenRouter/Chroma token in this file.
GOVERNANCE_AUDIENCE=
GOVERNANCE_BACKEND_SERVICE_ACCOUNT_EMAIL=
GOVERNANCE_TASKS_INVOKER_SERVICE_ACCOUNT_EMAIL=
GOVERNANCE_BACKEND_URL=
GOVERNANCE_BACKEND_AUDIENCE=
GOVERNANCE_GCS_BUCKET=
GOVERNANCE_DATABASE_SCHEMA=vera
GOVERNANCE_OPENROUTER_TIMEOUT_MS=60000
LABEL_SOURCE_ALLOWED_PDF_HOSTS=
CHROMA_ENDPOINT=
CHROMA_TENANT=default_tenant
CHROMA_DATABASE=default_database
CHROMA_TOKEN=
CHROMA_TIMEOUT_MS=30000
